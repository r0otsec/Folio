{# ── TECHNICAL FINDINGS OVERVIEW ─────────────────────────────────────────────── #}
{# Contains: (1) Risk distribution chart, (2) consolidated findings table        #}
{# This section sits between Executive Summary and Technical Summary.            #}
{% set rs = report.risk_summary %}

<div class="report-section page-break" id="finding-overview">

  <h2 class="plain-section-title">Technical Findings Overview</h2>

  {# ── Findings by severity bar chart ─────────────────────────── #}
  {% if report.risk_bar_svg %}
  <div class="avoid-break" style="margin-bottom:24px">
    <div style="display:flex;justify-content:center">
      {{ report.risk_bar_svg | safe }}
    </div>
  </div>
  {% endif %}

  {# ── Consolidated findings table — all sections ─────────────── #}
  {# Grouped by assessment section, sorted by severity within each #}

  {% for section in report.enabled_sections %}
  {% if section.findings %}

  <div style="margin-top:28px">

    <h3 class="phase-sub-heading" id="phase-{{ section.id_slug }}"
        style="break-after:avoid;page-break-after:avoid">{{ section.title }}</h3>

    <table class="overview-table">
      <thead>
        <tr>
          <th style="width:90px;text-align:center">Finding</th>
          <th>Title</th>
          <th style="width:90px;text-align:center">Risk</th>
        </tr>
      </thead>
      <tbody>
        {% for finding in section.findings %}
        <tr>
          <td style="text-align:center;padding:0">
            <a href="#finding-{{ finding.id | lower }}"
               style="display:block;padding:8px 12px;color:inherit;text-decoration:none;font-family:var(--font-mono);font-size:9.5px">{{ finding.id }}</a>
          </td>
          <td style="padding:0">
            <a href="#finding-{{ finding.id | lower }}"
               style="display:block;padding:8px 12px;color:inherit;text-decoration:none">{{ finding.title }}</a>
          </td>
          <td class="risk-cell-{{ finding.severity_key }}" style="text-align:center;padding:0;background:{{ finding.severity_color }} !important">
            <a href="#finding-{{ finding.id | lower }}"
               style="display:block;padding:8px 12px;color:#fff;font-weight:700;font-size:10px;text-transform:uppercase;letter-spacing:0.05em;text-decoration:none">{{ finding.severity_display }}</a>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

  </div>
  {% endif %}
  {% endfor %}

</div>
